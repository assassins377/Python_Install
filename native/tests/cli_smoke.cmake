file(MAKE_DIRECTORY "${TEST_DIR}/Каталог с пробелами")
file(WRITE "${TEST_DIR}/Каталог с пробелами/programs.json"
    "{\"_version\":2,\"categories\":{\"Тест\":[{\"name\":\"Программа\",\"cmd\":\"never-run.exe\"}]}}")
file(WRITE "${TEST_DIR}/broken.json" "{bad-json")
# Isolate executable-relative discovery from the build tree and caller's CWD.
file(REMOVE_RECURSE "${TEST_DIR}/portable")
file(MAKE_DIRECTORY "${TEST_DIR}/portable")
file(COPY "${APP}" DESTINATION "${TEST_DIR}/portable")
get_filename_component(app_name "${APP}" NAME)
set(APP "${TEST_DIR}/portable/${app_name}")
file(WRITE "${TEST_DIR}/portable/programs.json" "{invalid-example-must-not-be-read")
file(MAKE_DIRECTORY "${TEST_DIR}/software")
file(WRITE "${TEST_DIR}/software/wrong-cwd.exe" "inert fixture")

function(check expected)
    execute_process(COMMAND "${APP}" ${ARGN} WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${result}: ${errors}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

check(0 --version --catalog "${TEST_DIR}/missing.json")
if(NOT last_output MATCHES "MInstAll Native 0.1.0")
    message(FATAL_ERROR "Unexpected version output")
endif()
check(0 --help)
# Neither an implicit JSON file nor software/ in the CWD may fill the list.
check(0 --list)
if(NOT last_output STREQUAL "")
    message(FATAL_ERROR "Default list must start empty")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}/portable/software/Утилиты")
file(WRITE "${TEST_DIR}/portable/software/Утилиты/Новая программа.EXE" "inert fixture")
check(0 --list)
if(NOT last_output MATCHES "Новая программа" OR last_output MATCHES "wrong-cwd")
    message(FATAL_ERROR "Discovery must use executable-relative software/ and Unicode paths")
endif()
file(REMOVE "${TEST_DIR}/portable/software/Утилиты/Новая программа.EXE")
check(0 --list)
if(NOT last_output STREQUAL "")
    message(FATAL_ERROR "Removed programs must disappear")
endif()
check(0 --list --catalog "${TEST_DIR}/Каталог с пробелами/programs.json")
if(NOT last_output MATCHES "Программа")
    message(FATAL_ERROR "Unicode path/output did not round-trip")
endif()
check(3 --list --catalog "${TEST_DIR}/missing.json")
check(3 --list --catalog "${TEST_DIR}/broken.json")
if(NOT last_output STREQUAL "")
    message(FATAL_ERROR "Corrupt catalog must not produce partial output")
endif()
check(3 --list --catalog "${TEST_DIR}")
check(3 --install anything)
check(3 --catalog)
check(3 --list --version)
check(3 --unknown)
